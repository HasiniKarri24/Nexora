# Copy this file to .env in the same folder as package.json.
# Paste only the key after =. Do not include the curl command.
# Never prefix secrets with VITE_. Never upload .env or send it in chat.
SCRAPPA_API_KEY=

# Optional: if Google Play has its own separate Scrappa key, put it here.
# This overrides SCRAPPA_API_KEY for Google Play only.
SCRAPPA_GOOGLE_PLAY_API_KEY=

# Use these when Scrappa issued separate keys for its X endpoints.
# If left blank, the backend falls back to SCRAPPA_API_KEY.
SCRAPPA_X_PROFILE_API_KEY=
SCRAPPA_X_USER_SEARCH_API_KEY=
SCRAPPA_X_POST_SEARCH_API_KEY=
SCRAPPA_FACEBOOK_PROFILE_API_KEY=

# Official/service credentials for the included integrations.
GEMINI_API_KEY=
YOUTUBE_API_KEY=
TAVILY_API_KEY=


# Optional Gemini model override.
GEMINI_MODEL=gemini-3.5-flash
